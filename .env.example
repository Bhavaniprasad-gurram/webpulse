# ==========================================
# WebPulse Monitoring Platform Configuration
# ==========================================

# Database Connection (MySQL 8.x)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=webpulse_db

# Alternative direct Database URL (Overrules individual DB_* variables if set)
# Examples:
#   MySQL:  mysql+pymysql://root:your_password_here@127.0.0.1:3306/webpulse_db
#   SQLite: sqlite:///webpulse.db  (Convenient for zero-configuration testing)
DATABASE_URL=mysql+pymysql://root:your_password_here@127.0.0.1:3306/webpulse_db

# Monitoring Settings & Thresholds
DEFAULT_INTERVAL_SECONDS=60
DEFAULT_TIMEOUT_SECONDS=10
FAILURE_THRESHOLD=2
SLOW_RESPONSE_THRESHOLD_MS=1500

# Email Alerts (SMTP) - Optional
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=your_app_password
SMTP_SENDER=WebPulse Alerts <alerts@example.com>
ALERT_RECIPIENT=admin@example.com

# Logging
LOG_LEVEL=INFO
